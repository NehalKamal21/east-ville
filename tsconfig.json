{
  "compilerOptions": {
    "outDir": "./dist",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Node",
    "target": "ES6",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": "./",
    "paths": {
      "three": [
        "node_modules/three"
      ],
      "three/*": [
        "node_modules/three/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}